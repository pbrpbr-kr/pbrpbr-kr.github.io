# 이 파일을 .env 로 복사한 뒤 값을 직접 넣으세요. .env 는 git에 올라가지 않습니다.
# 필수 ---------------------------------------------------------------
# GitHub 저장소 (예: myname/skin-blog) 와 Fine-grained 토큰
# 토큰 권한: 이 저장소만 선택 → Contents: Read and write, Pages: Read and write
GITHUB_REPO=
GITHUB_TOKEN=

# 선택 (넣으면 그 소스를 수집, 비워 두면 건너뜀) ---------------------------
# PubMed 호출 한도 상향 (https://www.ncbi.nlm.nih.gov/account/ → API Key)
NCBI_API_KEY=
# 네이버 데이터랩 검색어 트렌드 (https://developers.naver.com → 애플리케이션 등록 → 데이터랩(검색어 트렌드))
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# YouTube Data API v3 (Google Cloud Console → API 키)
YOUTUBE_API_KEY=
# X API v2 (유료 Basic 이상에서 counts/recent 사용 가능)
X_BEARER_TOKEN=
# Threads API (Meta 개발자 앱, threads_keyword_search 권한)
THREADS_ACCESS_TOKEN=
# Instagram Graph API (비즈니스/크리에이터 계정, instagram_basic + 해시태그 검색 권한)
IG_USER_ID=
IG_ACCESS_TOKEN=
